{
  "name": "Gear Clicker",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Modules": {
        "$className": "Folder",
        "$path": "ReplicatedStorage/Modules"
      },
      "Remotes": {
        "$className": "Folder",
        "OpenBox": { "$className": "RemoteEvent" },
        "EquipMotor": { "$className": "RemoteEvent" },
        "MotorEquipped": { "$className": "RemoteEvent" },
        "EquipGear": { "$className": "RemoteEvent" },
        "GearEquipped": { "$className": "RemoteEvent" },
        "UnequipGear": { "$className": "RemoteEvent" },
        "ClickGear": { "$className": "RemoteEvent" },
        "CashUpdated": { "$className": "RemoteEvent" },
        "WelcomeBack": { "$className": "RemoteEvent" },
        "RequestSave": { "$className": "RemoteEvent" },
        "GetPlayerData": { "$className": "RemoteFunction" },
        "GetCatalog": { "$className": "RemoteFunction" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Services": {
        "$className": "Folder",
        "$path": "ServerScriptService/Services"
      },
      "Main": {
        "$path": "ServerScriptService/Main.server.lua"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$className": "Folder",
          "ClientMain": { "$path": "StarterPlayerScripts/Client/ClientMain.client.lua" },
          "HUDController": { "$path": "StarterPlayerScripts/Client/HUDController.lua" },
          "UnboxController": { "$path": "StarterPlayerScripts/Client/UnboxController.lua" },
          "InventoryController": { "$path": "StarterPlayerScripts/Client/InventoryController.lua" }
        }
      }
    }
  }
}
